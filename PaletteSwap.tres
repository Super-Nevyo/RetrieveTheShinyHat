[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_wuiap"]
size = Vector2(1120, 1180)
expression = "vec2 new_uv = vec2(0,0);

for (int i = 0; i < colour_count; i++){
	float u = (float(i) +0.5)/float(colour_count);
	float v = 0.5;
	vec2 uv = vec2(u,v);
	vec4 original_palette_colour = texture(original_palette, uv);
	float dist = distance(colour, original_palette_colour);
	
	if(dist == 0.0) {
		new_uv = uv;
		if (texture(new_palette, new_uv) == vec4(0,0,0,1)){
			new_alpha = 0.0;
		}
		else new_alpha = 1.0;
		break;
	}
	
}

new_colour = texture(new_palette, new_uv);"

